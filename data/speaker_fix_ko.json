  "SCE-001-0111": "하마구치 박사「메구미가 옳다.\n미츠요 박사의 뜻을\n새겨라」",
  "SCE-001-0113": "하마구치 박사「알겠나?\n기지에 대공마룡대가 기다려\n모두 가자」",
  "SCE-001-0105": "다이지로「뭣!」",
  "SCE-000-0002": "그것은 어리석음을 고쳐\n새 환경에 적응하려는\n인간의 본능이리라..\n이런 인류도 우주에서\n살 수 있다고 믿지 않으면\n사람의 역사는 너무 슬프다",
  "SCE-000-0003": "크로노클\n「내 테스트기라니」",
  "SCE-000-0004": "웃소\n「안 되나..」",
  "SCE-000-0006": "웃소\n「젠장-!」",
  "SCE-000-0005": "크로노클\n「다음은 콕핏이다!\n 파일럿!!」",
  "SCE-000-0007": "웃소\n「이건가!? 비상탈출!」",
  "SCE-000-0010": "크로노클\n「저 점퍼 색은\n 콕핏에 뛰어든 놈이다!」",
  "SCE-000-0011": "웃소\n「우와아아아.아아..앗!」",
  "SCE-000-0012": "크로노클\n「저 높이면.. 못 산다」",
  "SCE-000-0013": "웃소\n「..어라..큰일났네. 아.야야. ..온몸이 아파..\n 어떻게 된 거야?」",
  "SCE-000-0014": "웃소\n(어쩌다 이렇게 된 거지?)",
  "SCE-000-0015": "웃소\n「베스파 모빌슈트를\n 조종하게 될 줄이야..」",
  "SCE-000-0016": "로메로\n「좀 더 천천히 아직 멀었어」",
  "SCE-000-0017": "마베트\n「폭격이 언제 그칠지 모르고 ..」",
  "SCE-000-0018": "마베트\n「웃소는 내가 찾을 테니\n 카미온에 가 있어」",
  "SCE-000-0019": "카테지나\n「카미온에 카를만의\n 기저귀 가방이 있잖아?」",
  "SCE-000-0021": "마베트\n「웃소는 꼭 우이그로\n 데려갈 테니, 안심해」",
  "SCE-000-0023": "카를\n「으에- 으에엥!\n 으에에엥!!」",
  "SCE-000-0024": "카테지나\n「자, 기저귀」",
  "SCE-000-0025": "레오니드\n「위로지만.. 무리하지 마」",
  "SCE-000-0026": "마베트\n「위로도 기분전환이죠」",
  "SCE-000-0027": "웃소\n「바람이 바뀌었어..움직여야..\n 으윽.온몸이.아파」",
  "SCE-000-0028": "뉴응 백작\n「어제는 안 왔지만\n 마찬가지군..\n 카테지나 양은, 집에 가나?」",
  "SCE-000-0029": "카테지나\n「..우이그는.. 이렇게 폭격당한 게 잘된 일이에요」",
  "SCE-000-0031": "카테지나\n「특권에 매달리던 자들은\n 모두 타락해 버렸으니까요」",
  "SCE-000-0032": "뉴응 백작\n「하지만, 사람이 할 짓이 아니야」",
  "SCE-000-0033": "카테지나\n「역사가 그랬던가요」",
  "SCE-000-0034": "오델로\n「라겐과 똑같잖아!」",
  "SCE-000-0001": "지구를 오염시킨 인류가\n 우주로 이주하여\n충분히 익숙해진 시대..\n그러나 인류는\n 이 우주에서도 지구처럼\n전쟁의 역사를 되풀이했다"
 }
